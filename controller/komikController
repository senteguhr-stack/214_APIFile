// Memanggil model dari models/index.js (PENTING agar relasi terbaca)
const { Komik, Penulis, Genre } = require('../models');

// 1. GET ALL KOMIK (Include Penulis & Genre)
exports.getAllKomik = async (req, res) => {
  try {
    const komik = await Komik.findAll({
      include: [
        { model: Penulis, as: 'penulis' },
        { model: Genre, as: 'genre' }
      ]
    });
    return res.status(200).json({
      status: 'success',
      data: komik
    });
  } catch (error) {
    return res.status(500).json({ status: 'error', message: error.message });
  }
};

// 2. GET KOMIK BY ID
exports.getKomikById = async (req, res) => {
  try {
    const { id } = req.params;
    const komik = await Komik.findByPk(id, {
      include: [
        { model: Penulis, as: 'penulis' },
        { model: Genre, as: 'genre' }
      ]
    });

    if (!komik) {
      return res.status(404).json({ status: 'fail', message: 'Komik tidak ditemukan' });
    }

    return res.status(200).json({
      status: 'success',
      data: komik
    });
  } catch (error) {
    return res.status(500).json({ status: 'error', message: error.message });
  }
};

// 3. CREATE KOMIK (POST)
exports.createKomik = async (req, res) => {
  try {
    const { judul, harga, penulisId, genreId } = req.body;

    if (!judul || !penulisId || !genreId) {
      return res.status(400).json({
        status: 'fail',
        message: 'Judul, penulisId, dan genreId wajib diisi'
      });
    }

    const komikBaru = await Komik.create({
      judul,
      harga,
      penulisId,
      genreId
    });

    return res.status(201).json({
      status: 'success',
      message: 'Komik berhasil ditambahkan',
      data: komikBaru
    });
  } catch (error) {
    return res.status(500).json({ status: 'error', message: error.message });
  }
};

// 4. UPDATE KOMIK (PUT)
exports.updateKomik = async (req, res) => {
  try {
    const { id } = req.params;
    const { judul, harga, penulisId, genreId } = req.body;

    const komik = await Komik.findByPk(id);
    if (!komik) {
      return res.status(404).json({ status: 'fail', message: 'Komik tidak ditemukan' });
    }

    await komik.update({
      judul: judul || komik.judul,
      harga: harga || komik.harga,
      penulisId: penulisId || komik.penulisId,
      genreId: genreId || komik.genreId
    });

    return res.status(200).json({
      status: 'success',
      message: 'Data komik berhasil diperbarui',
      data: komik
    });
  } catch (error) {
    return res.status(500).json({ status: 'error', message: error.message });
  }
};

// 5. DELETE KOMIK
exports.deleteKomik = async (req, res) => {
  try {
    const { id } = req.params;
    const komik = await Komik.findByPk(id);

    if (!komik) {
      return res.status(404).json({ status: 'fail', message: 'Komik tidak ditemukan' });
    }

    await komik.destroy();

    return res.status(200).json({
      status: 'success',
      message: 'Komik berhasil dihapus'
    });
  } catch (error) {
    return res.status(500).json({ status: 'error', message: error.message });
  }
};